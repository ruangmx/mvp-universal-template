# Configuração Global de Desenvolvimento
# Copie para .env antes de rodar o projeto

# Banco de Dados PostgreSQL (Local Docker ou Nuvem Neon/Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mvp_dev"

# Porta da API NestJS
API_PORT=3333

# Segredo JWT para desenvolvimento (substitua em produção)
JWT_SECRET="dev-insecure-jwt-secret-replace-in-production-min-32-chars"

# URL pública da API para o frontend
NEXT_PUBLIC_API_URL="http://localhost:3333"

